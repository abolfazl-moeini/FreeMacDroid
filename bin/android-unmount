#!/bin/bash
# Cleanly unmount the Android phone from Finder and stop aft-mtp-mount.
set -uo pipefail

SYSBIN="${FREEMACDROID_SYSBIN:-}"

cmd_path() {
    local name="$1" fallback="$2"
    if [ -n "$SYSBIN" ] && [ -x "$SYSBIN/$name" ]; then
        printf '%s\n' "$SYSBIN/$name"
    else
        printf '%s\n' "$fallback"
    fi
}

MOUNT_CMD="$(cmd_path mount /sbin/mount)"
GREP_CMD="/usr/bin/grep"
DISKUTIL_CMD="$(cmd_path diskutil /usr/sbin/diskutil)"
UMOUNT_CMD="$(cmd_path umount /sbin/umount)"
PGREP_CMD="$(cmd_path pgrep /usr/bin/pgrep)"
PKILL_CMD="$(cmd_path pkill /usr/bin/pkill)"

MNT="${ANDROID_MOUNT_DIR:-$HOME/Android}"
REAL_MNT="$MNT"
if [ -L "$MNT" ] || [ -d "$MNT" ]; then
    REAL_MNT="$(cd "$MNT" 2>/dev/null && pwd -P || printf '%s\n' "$MNT")"
fi

for _target in "$REAL_MNT" "$MNT"; do
    if "$MOUNT_CMD" | "$GREP_CMD" -Fq " on $_target ("; then
        if [ -z "$SYSBIN" ] && "$PGREP_CMD" -x aft-mtp-mount >/dev/null 2>&1; then
            "$UMOUNT_CMD" "$_target" 2>/dev/null \
                || "$DISKUTIL_CMD" unmount "$_target" 2>/dev/null \
                || "$DISKUTIL_CMD" unmount force "$_target" 2>/dev/null \
                || "$UMOUNT_CMD" -f "$_target"
        else
            "$DISKUTIL_CMD" unmount "$_target" 2>/dev/null \
                || "$DISKUTIL_CMD" unmount force "$_target" 2>/dev/null \
                || "$UMOUNT_CMD" -f "$_target"
        fi
    fi
done
"$PKILL_CMD" -x aft-mtp-mount 2>/dev/null || true
exit 0
